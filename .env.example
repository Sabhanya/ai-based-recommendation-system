# Croply AI - Frontend Environment Variables

# Base URL for the Python FastAPI / Flask backend API
# If empty or offline, Croply AI uses the high-precision client-side mock ML engine
VITE_API_BASE_URL=http://localhost:8000/api

# Set to 'false' when connecting to live backend ML server
VITE_USE_MOCK_API=true

# Application Name
VITE_APP_TITLE=Croply AI
